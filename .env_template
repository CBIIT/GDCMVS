# GDCMVS Root Environment Variables
# Copy this file to .env and update values as needed

# Node environment (dev, test, stage, prod)
# For local development, use: development
NODE_ENV=development

# Server port number
# Default: 3000
PORT=3000

# Log directory path
# For macOS/Linux: ./logs or /path/to/logs
# For Windows: ./logs or C:\path\to\logs
LOGDIR=./logs
